{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/python3",
      "runtimeArgs": ["-m", "uvicorn", "vm_builder.api.app:app", "--host", "0.0.0.0", "--port", "8080", "--reload"],
      "port": 8080
    },
    {
      "name": "web",
      "runtimeExecutable": "/opt/homebrew/bin/npm",
      "runtimeArgs": ["run", "dev", "--prefix", "vm-builder-web"],
      "port": 5173
    }
  ]
}
